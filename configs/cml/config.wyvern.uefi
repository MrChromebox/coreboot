CONFIG_VENDOR_GOOGLE=y
CONFIG_IFD_BIN_PATH="3rdparty/blobs/mainboard/google/puff/wyvern/flashdescriptor.bin"
CONFIG_ME_BIN_PATH="3rdparty/blobs/mainboard/google/puff/puff/me.bin"
CONFIG_BOARD_GOOGLE_WYVERN=y
CONFIG_HAVE_IFD_BIN=y
CONFIG_FSP_HEADER_PATH="3rdparty/blobs/intel/fsp/CometLake1/include"
CONFIG_FSP_M_FILE="3rdparty/blobs/mainboard/google/puff/wyvern/fspm.bin"
CONFIG_FSP_S_FILE="3rdparty/blobs/mainboard/google/puff/wyvern/fsps.bin"
CONFIG_EC_GOOGLE_CHROMEEC_FIRMWARE_EXTERNAL=y
CONFIG_EC_GOOGLE_CHROMEEC_FIRMWARE_FILE="3rdparty/blobs/mainboard/google/puff/puff/ec.RW.flat"
CONFIG_HAVE_ME_BIN=y
CONFIG_DO_NOT_TOUCH_DESCRIPTOR_REGION=y
# CONFIG_FSP_USE_REPO is not set
CONFIG_ADD_FSP_BINARIES=y
CONFIG_EDK2_ENABLE_IPXE=y
