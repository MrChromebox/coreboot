CONFIG_VENDOR_GOOGLE=y
CONFIG_INTEL_GMA_VBT_FILE="3rdparty/blobs/mainboard/google/brya/brya/crota/vbt.bin"
CONFIG_IFD_BIN_PATH="3rdparty/blobs/mainboard/google/brya/brya/crota/flashdescriptor.bin"
CONFIG_ME_BIN_PATH="3rdparty/blobs/mainboard/google/brya/brya/crota/me.bin"
CONFIG_BOARD_GOOGLE_CROTA=y
CONFIG_HAVE_IFD_BIN=y
CONFIG_FSP_HEADER_PATH="src/vendorcode/intel/fsp/fsp2_0/raptorlake"
