# Puff/Kaisa UEFI 16MiB layout: MRC + SPD cache for fast boot (no ChromeOS vboot A/B).
# Same SI_BIOS base/size and RW_MISC as chromeos-16MiB so MRC/SPD cache code works.
FLASH 0x1000000 {
	SI_ALL@0x0 0x300000 {
		SI_DESC@0x0 0x1000
		SI_ME@0x1000 0x2ff000
	}
	SI_BIOS@0x300000 0xd00000 {
		RW_FW_MAIN@0x0 0x7d0000
		RW_MISC@0x7d0000 0x30000 {
			UNIFIED_MRC_CACHE(PRESERVE)@0x0 0x20000 {
				RECOVERY_MRC_CACHE@0x0 0x10000
				RW_MRC_CACHE@0x10000 0x10000
			}
			RW_VPD(PRESERVE)@0x20000 0x2000
			RW_NVRAM(PRESERVE)@0x2a000 0x5000
			RW_SPD_CACHE(PRESERVE)@0x2f000 0x1000
		}
		SMMSTORE(PRESERVE)@0x800000 0x80000
		RW_LEGACY(CBFS)@0x880000 0x80000
		WP_RO@0x900000 0x400000 {
			RO_VPD(PRESERVE)@0x0 0x4000
			RO_SECTION@0x4000 0x3fc000 {
				FMAP@0x0 0x800
				RO_FRID@0x800 0x40
				RO_FRID_PAD@0x840 0x7c0
				COREBOOT(CBFS)@0x4000 0x3f8000
			}
		}
	}
}
