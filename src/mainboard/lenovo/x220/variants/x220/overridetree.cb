chip northbridge/intel/sandybridge
	device domain 0 on
		chip southbridge/intel/bd82x6x # Intel Series 6 Cougar Point PCH
			device ref ehci1 on
				chip drivers/usb/acpi
					device ref ehci_root_hub1 on
						chip drivers/usb/acpi
							device ref ehci_rm_hub1 on
								chip drivers/usb/acpi
									register "desc" = ""USB2.0 A Near VGA""
									register "type" = "UPC_TYPE_A"
									register "use_custom_pld" = "true"
									register "custom_pld" = "ACPI_PLD_TYPE_A(LEFT, LEFT, ACPI_PLD_GROUP(1, 0))"
									device ref usb2_port0 on end
								end
								chip drivers/usb/acpi
									register "desc" = ""USB2.0 A Near ExpressCard""
									register "type" = "UPC_TYPE_A"
									register "use_custom_pld" = "true"
									register "custom_pld" = "ACPI_PLD_TYPE_A(LEFT, RIGHT, ACPI_PLD_GROUP(1, 0))"
									device ref usb2_port1 on end
								end
								chip drivers/usb/acpi
									register "desc" = ""USB2 WLAN""
									register "type" = "UPC_TYPE_INTERNAL"
									device ref usb2_port2 on end
								end
								chip drivers/usb/acpi
									register "desc" = ""USB2 WWAN""
									register "type" = "UPC_TYPE_INTERNAL"
									device ref usb2_port3 on end
								end
								chip drivers/usb/acpi
									register "desc" = ""USB2 ExpressCard""
									register "type" = "UPC_TYPE_INTERNAL"
									device ref usb2_port5 on end
								end

							end
						end
					end
				end
			end
			device ref ehci2 on
				chip drivers/usb/acpi
					device ref ehci_root_hub2 on
						chip drivers/usb/acpi
							device ref ehci_rm_hub2 on
								chip drivers/usb/acpi
									register "desc" = ""Docking 2""
									register "type" = "UPC_TYPE_A"
									register "use_custom_pld" = "true"
									register "custom_pld" = "ACPI_PLD_TYPE_A(LEFT, LEFT, ACPI_PLD_GROUP(3, 0))"
									device ref usb2_port8 on end
								end
								chip drivers/usb/acpi
									register "desc" = ""System Port 1""
									register "type" = "UPC_TYPE_A"
									register "use_custom_pld" = "true"
									register "custom_pld" = "ACPI_PLD_TYPE_A(RIGHT, LEFT, ACPI_PLD_GROUP(2, 0))"
									device ref usb2_port9 on end
								end
								chip drivers/usb/acpi
									register "desc" = ""FPR""
									register "type" = "UPC_TYPE_INTERNAL"
									device ref usb2_port10 on end
								end
								chip drivers/usb/acpi
									register "desc" = ""BDC""
									register "type" = "UPC_TYPE_INTERNAL"
									device ref usb2_port11 on end
								end
								chip drivers/usb/acpi
									register "desc" = ""Docking 1""
									register "type" = "UPC_TYPE_A"
									register "use_custom_pld" = "true"
									register "custom_pld" = "ACPI_PLD_TYPE_A(LEFT, RIGHT, ACPI_PLD_GROUP(3, 0))"
									device ref usb2_port12 on end
								end
								chip drivers/usb/acpi
									register "desc" = ""Camera""
									register "type" = "UPC_TYPE_INTERNAL"
									device ref usb2_port13 on end
								end
							end
						end
					end
				end
			end
			register "usb_port_config" = "{
				{1, 0, 0 },  /* P00: System Port (near VGA) */
				{1, 1, 1 },  /* P01: System Port (near ExpressCard) */
				{1, 1, -1 }, /* P02: WLAN */
				{1, 1, -1 }, /* P03: WWAN */
				{0, 0, -1},  /* P04: Reserved */
				{1, 1, -1},  /* P05: ExpressCard */
				{0, 0, -1},  /* P06: Reserved */
				{0, 0, -1 }, /* P07: Reserved */
				{1, 1, -1 }, /* P08: Docking */
				{1, 1, 5 },  /* P09: Always On System Port */
				{1, 1, -1 }, /* P10: FPR */
				{1, 1, -1 }, /* P11: BDC */
				{1, 1, 7 },  /* P12: Docking */
				{1, 1, -1 }, /* P13: Camera */
			}"

			device ref lpc on
				chip ec/lenovo/h8
					device ref lenovo_ec on end
					register "has_thinklight" = "true"
					register "eventa_enable" = "0x01"
					register "eventb_enable" = "0xf0"
				end
			end
		end
	end
end
